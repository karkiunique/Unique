{
  "name": "voicereach-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoiceReach API server (Express + Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && node --check src/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "supertest": "7.0.0",
    "vitest": "2.1.8"
  }
}
