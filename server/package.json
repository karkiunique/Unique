{
  "name": "voicereach-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoiceReach API server (Express + Supabase)",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
