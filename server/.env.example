# VoiceReach server — copy to .env and fill in. NEVER commit .env.
# Placeholders only in this file.

# Supabase (service-role key is server-only; it bypasses RLS and must never reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google / Gmail API OAuth 2.0 client (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# AI + lead data
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
TAVILY_API_KEY=

# Queue
REDIS_URL=redis://localhost:6379

# Frontend origin — CORS is locked to exactly this value
APP_URL=http://localhost:5173

# 32-byte key for AES-256-GCM encryption of Gmail refresh tokens + voice exemplars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# HMAC-SHA256 secret for signed unsubscribe tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUB_SECRET=

# Port the API listens on (must match GOOGLE_REDIRECT_URI)
PORT=3000
