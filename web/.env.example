# VoiceReach web — copy to .env and fill in. NEVER commit .env.
# Vite exposes every VITE_* var to the browser bundle: anon key only, never the
# service-role key and never any other server secret.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Express API (routes are mounted under /api)
VITE_API_URL=http://localhost:3000
