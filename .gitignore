# dependencies
node_modules/
.pnp/
.pnp.js

# env — NEVER commit real secrets, only .env.example
.env
.env.*
# EXCEPTION, and not a secret: one line, VITE_API_URL=(empty), which forces
# production builds to same-origin. Vite compiles VITE_* in at BUILD time, so this
# has to be in the repo for Railway to build correctly.
!web/.env.production
!.env.example

# build output
dist/
build/
coverage/
*.tsbuildinfo

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / os
.DS_Store
.idea/
.vscode/
*.swp

# local supabase
supabase/.temp/
supabase/.branches/
files.zip

# local lead lists — a filled-in CSV carries real recipient addresses, which is
# third-party personal data (CLAUDE.md § Privacy). Never commit one.
*-leads.csv
*-test-leads.csv
.gstack/
